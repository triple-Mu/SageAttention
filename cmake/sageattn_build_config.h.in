#pragma once

// Which kernel families were compiled into this _C extension. The resolve()
// dispatcher uses these to pick a backend and to produce actionable "rebuilt
// with TORCH_CUDA_ARCH_LIST=..." errors for families that are absent.
#cmakedefine01 SAGEATTN_BUILD_SM80
#cmakedefine01 SAGEATTN_BUILD_SM89
#cmakedefine01 SAGEATTN_BUILD_SM90
#cmakedefine01 SAGEATTN_BUILD_SM100
#cmakedefine01 SAGEATTN_BUILD_SM120

// Whether the varlen (packed [total_tokens, heads, head_dim]) kernel TUs were
// compiled (CMake -DSAGE_BUILD_VARLEN=OFF drops them). The varlen ops are
// always registered, so a build without them fails with a message instead of
// with a missing operator.
#cmakedefine01 SAGEATTN_BUILD_VARLEN

// Whether quant_v_fp8 fuses the V transpose into the fp8 quantization kernel
// (CMake -DSAGE_FUSED_V_QUANT=OFF restores the two-kernel pair). Both produce
// the same bits; only the kernel count and the traffic differ.
#cmakedefine01 SAGEATTN_FUSED_V_QUANT

// Arithmetic opt-ins (CMake -DSAGE_OPT_*=ON). 0 is the reference arithmetic the
// bit-exact golden dumps were taken with. The recorded names deliberately differ
// from the SAGE_OPT_* compile definitions the kernels guard on, so including this
// header can never switch a kernel on.
#cmakedefine01 SAGEATTN_OPT_MAGIC_I2F
#cmakedefine01 SAGEATTN_OPT_HMUL2_NORM
#cmakedefine01 SAGEATTN_OPT_FUSED_EPILOGUE

#define SAGEATTN_BUILT_ARCHS_STR "@SAGE_REQUESTED_ARCHS_STR@"
#define SAGEATTN_VERSION "@SAGE_VERSION@"
