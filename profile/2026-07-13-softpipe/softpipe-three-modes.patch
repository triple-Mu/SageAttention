+                    tma_atom_k, tKgK, tKsK, tma_atom_v, tVgV, tVsV)
+                if const_expr(masked):
+                    cute.nvgpu.warpgroup.wait_group(0)
+                    self.merge_pv(pv_tiled_mma, acc_pv, acc_pv_temp, o_scale)
+            else:
+                # qk_hide：commit 序「PV_t 先、QK_{t+1} 后」→ W(1) 恰等 PV_t、
+                # 保 QK_{t+1} 在飞 → merge_t ∥ QK_{t+1}；尾块无 QK_{t+1}，W(0)
+                if const_expr(not masked):
+                    k_tok = load_kv_consumer.try_wait()
+                    k_handle = load_kv_consumer.wait_and_advance(k_tok)
+                    cute.nvgpu.warpgroup.fence()
+                    self.gemm_zero_acc(
+                        qk_tiled_mma,
+                        tSrQ[(None, None, None, q_handle.index)],
+                        tSrK[(None, None, None, k_handle.index)], acc_qk)
+                    cute.nvgpu.warpgroup.commit_group()
+                    cute.nvgpu.warpgroup.wait_group(1)
+                else:
+                    cute.nvgpu.warpgroup.wait_group(0)
+                v_handle.release()
+                kv_issue, load_kv_producer = self.issue_kv(
+                    warp_idx, kv_issue, kv_issue_limit, load_kv_producer,
+                    tma_atom_k, tKgK, tKsK, tma_atom_v, tVgV, tVsV)
+                self.merge_pv(pv_tiled_mma, acc_pv, acc_pv_temp, o_scale)
+        return (load_kv_consumer, load_kv_producer, kv_iter, kv_issue,
+                s_max, a_sum, k_handle)
+
